{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "leave-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  // 배포 시 DNS 레코드와 인증서를 wrangler가 자동으로 만든다 (moveto.kr 존이 이 계정에 있어야 함)
  "routes": [
    {
      "pattern": "api.leave.moveto.kr",
      "custom_domain": true,
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "leave-db",
      "database_id": "ac2047fe-6c01-4f3d-a8c2-8d476cbcf9ea",
      "migrations_dir": "migrations",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "CACHE",
      // 실배포 전 `wrangler kv namespace create CACHE`로 생성한 실제 ID로 교체 (로컬 개발은 로컬 시뮬레이션 사용)
      "id": "a22fbf38ce4a41e291915286e120d51f",
    },
  ],
  // 매일 03:10 UTC(= 한국 12:10). 보관 기간이 지난 접속 기록·푸시 로그와
  // 만료된 세션을 지운다 (src/index.ts의 scheduled 핸들러).
  "triggers": {
    "crons": ["10 3 * * *"],
  },
  "vars": {
    // 웹 오리진으로 제한 (네이티브 앱은 브라우저 CORS 대상이 아니므로 영향 없음)
    "CORS_ORIGIN": "https://leave.moveto.kr",
    // 접속 기록·푸시 로그 보관 일수. 개인정보 처리방침과 같은 값이어야 한다.
    "LOG_RETENTION_DAYS": "90",
  },
  "observability": {
    "enabled": true,
  },
}
