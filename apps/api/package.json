{
  "name": "@leave/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./db": "./src/db/schema.ts",
    "./server": "./src/admin-shared.ts"
  },
  "scripts": {
    "dev": "wrangler dev --port 8787 --var CORS_ORIGIN:http://localhost:5173 --var API_ORIGIN:http://localhost:8787",
    "deploy": "pnpm db:migrate:remote && wrangler deploy",
    "check-types": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply leave-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply leave-db --remote",
    "lint": "eslint . --max-warnings 0",
    "types": "wrangler types --include-runtime false --strict-vars false --env-interface WorkerEnv worker-env.d.ts",
    "types:check": "wrangler types --include-runtime false --strict-vars false --env-interface WorkerEnv worker-env.d.ts --check"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.6.3",
    "@leave/shared": "workspace:*",
    "@scalar/hono-api-reference": "^0.11.16",
    "@simplewebauthn/server": "13.3.3",
    "drizzle-orm": "^0.45.4",
    "hono": "4.13.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261016.1",
    "drizzle-kit": "^0.31.11",
    "typescript": "5.9.2",
    "wrangler": "^4.151.0"
  }
}
