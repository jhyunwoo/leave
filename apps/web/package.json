{
  "name": "@leave/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173",
    "build": "tsc --noEmit && vite build && vite build --ssr src/entry-prerender.tsx --outDir dist-prerender && node scripts/build-seo.mjs",
    "fonts:generate": "node scripts/generate-font-subset.mjs",
    "preview": "vite preview",
    "deploy": "pnpm build && wrangler deploy",
    "check-types": "tsc --noEmit",
    "og:generate": "node scripts/generate-og-image.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "types": "wrangler types",
    "types:check": "wrangler types --check",
    "lint": "eslint . --max-warnings 0"
  },
  "dependencies": {
    "@leave/api": "workspace:*",
    "@leave/client": "workspace:*",
    "@leave/shared": "workspace:*",
    "@simplewebauthn/browser": "13.3.0",
    "@tanstack/react-query": "^5.104.3",
    "hono": "4.13.2",
    "jotai": "^2.20.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-router": "^7.18.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^5.9.2",
    "vite": "^8.3.4",
    "vitest": "^3.2.7",
    "wrangler": "^4.151.0"
  }
}
