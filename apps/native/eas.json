{
  "cli": {
    "version": ">= 21.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.leave.moveto.kr"
      }
    },
    "preview": {
      "channel": "preview",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.leave.moveto.kr"
      }
    },
    "closed": {
      "channel": "closed-test",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.leave.moveto.kr"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.leave.moveto.kr"
      }
    }
  },
  "submit": {
    "closed": {
      "android": {
        "track": "alpha",
        "releaseStatus": "completed"
      }
    },
    "production": {
      "android": {
        "track": "internal",
        "releaseStatus": "completed"
      },
      "ios": {
        "ascAppId": "6792287152"
      }
    }
  }
}
