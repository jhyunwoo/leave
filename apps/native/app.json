{
  "expo": {
    "name": "리브",
    "slug": "leave",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/app-icon-v3.png",
    "scheme": "leave",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.leave.mobile",
      "icon": "./assets/images/app-icon-v3.png",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "app.leave.mobile",
      "permissions": ["android.permission.RECORD_AUDIO"],
      "icon": "./assets/images/app-icon-v3.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground-v3.png",
        "monochromeImage": "./assets/images/android-icon-monochrome-v2.png",
        "backgroundColor": "#0e0f0c"
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/app-icon-v3.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/images/splash-mark-v3.png",
          "imageWidth": 128,
          "resizeMode": "contain"
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#9fe870"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "프로필 사진 등록을 위해 사진 보관함에 접근합니다."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d1159900-97c5-4f49-beb7-1298d0d776ab"
      }
    },
    "owner": "jhyunwoo"
  }
}
