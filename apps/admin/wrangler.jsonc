{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "leave-admin",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-26",
  "compatibility_flags": ["nodejs_compat"],
  // 배포 시 DNS 레코드와 인증서를 wrangler가 자동으로 만든다 (moveto.kr 존이 이 계정에 있어야 함)
  "routes": [
    {
      "pattern": "admin.leave.moveto.kr",
      "custom_domain": true,
    },
  ],
  "assets": {
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "leave-db",
      "database_id": "ac2047fe-6c01-4f3d-a8c2-8d476cbcf9ea",
      "migrations_dir": "../api/migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "leave-images",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "a22fbf38ce4a41e291915286e120d51f",
    },
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
}
