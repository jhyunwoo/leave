{
  "name": "@leave/admin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 5174",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "deploy": "pnpm build && wrangler deploy",
    "check-types": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "test:e2e": "playwright test",
    "db:migrate:local": "wrangler d1 migrations apply leave-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply leave-db --remote",
    "admin:bootstrap": "node scripts/bootstrap-admin.mjs",
    "lint": "eslint . --max-warnings 0",
    "types": "wrangler types",
    "types:check": "wrangler types --check"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/noto-sans-kr": "^5.3.1",
    "@leave/api": "workspace:*",
    "@leave/shared": "workspace:*",
    "@simplewebauthn/browser": "13.3.0",
    "@simplewebauthn/server": "13.3.3",
    "@tanstack/react-query": "^5.104.3",
    "drizzle-orm": "^0.45.4",
    "hono": "4.13.2",
    "lucide-react": "^0.554.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-router": "^7.18.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "5.9.2",
    "vite": "^8.3.4",
    "wrangler": "^4.151.0"
  }
}
