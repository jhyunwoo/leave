{
  "name": "@leave/admin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 5174",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "deploy": "pnpm build && wrangler deploy",
    "check-types": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "test:e2e": "playwright test",
    "db:migrate:local": "wrangler d1 migrations apply leave-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply leave-db --remote",
    "admin:bootstrap": "node scripts/bootstrap-admin.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/manrope": "^5.2.8",
    "@fontsource-variable/noto-sans-kr": "^5.3.0",
    "@leave/api": "workspace:*",
    "@leave/shared": "workspace:*",
    "@tanstack/react-query": "^5.101.2",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.30",
    "lucide-react": "^0.554.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-router": "^7.13.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.47.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "typescript": "5.9.2",
    "vite": "^8.1.4",
    "wrangler": "^4.114.0"
  }
}
