{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "jsx": "react-jsx",
    "verbatimModuleSyntax": true,
    // test/single-instance.test.ts가 node:fs로 설치 레이아웃을 직접 들여다본다.
    // src가 플랫폼 API에 손대는 것은 ESLint의 의존 방향 규칙이 막는다.
    "types": ["node"]
  },
  "include": ["src", "test", "vitest.config.ts"]
}
